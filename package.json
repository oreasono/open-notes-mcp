    "lib",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@open-notes-mcp/darwin-arm64": "0.2.0",
    "@open-notes-mcp/darwin-x64": "0.2.0",
    "@open-notes-mcp/linux-arm64": "0.2.0",
